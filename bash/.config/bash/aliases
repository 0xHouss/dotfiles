# vim: set ft=bash:

alias resource='source ~/.bashrc'
alias fman='compgen -c | fzf | xargs man'
alias stow='stow -t ~'
alias t='tmux new -s "$(basename "$PWD")"'
alias tl='tmux ls'
alias n='nvim'
alias cc='claude --dangerously-skip-permissions'

unalias cy 2>/dev/null # remove omarchy default cy='codex ...'
alias lg='lazygit'
alias ld='lazydocker'
alias dc='docker compose'

alias dot='cd ~/dotfiles/'
alias work='cd ~/Work/'
alias om='cd ~/.local/share/omarchy/'

