#!/usr/bin/env bash
# Run inside the terminal the menu opens. Keeps the window up when ssh fails,
# so the error can be read instead of vanishing with the terminal.
# The menu starts this from the shell's environment, not from an interactive
# bash, so exports that live in the user's bash config (SSH_AUTH_SOCK pointing
# at a password manager's agent, say) are missing and ssh cannot see the keys.
if [[ -z ${SSH_AUTH_SOCK:-} && -r $HOME/.config/bash/envs ]]; then
  source "$HOME/.config/bash/envs" 2>/dev/null
fi

ssh "$@"
status=$?
if (( status != 0 )); then
  printf '\nssh exited with status %s. Press any key to close.' "$status"
  read -rsn1
fi
exit "$status"
