#!/usr/bin/env bash

VAULT=$(jq -r '[.vaults[] | select(.open)][0].path // empty' ~/.config/obsidian/obsidian.json)
[[ -n "$VAULT" ]] || { echo "No open Obsidian vault found" >&2; exit 1; }

NOTE_DIR="${VAULT}/8 - Instant Notes"
TODAY=$(date +"%Y-%m-%d")

# Find the next sequential number for today
SEQ=1
while [[ -e "${NOTE_DIR}/${TODAY}-${SEQ}.md" ]]; do
  ((SEQ++))
done

NOTE_PATH="${NOTE_DIR}/${TODAY}-${SEQ}.md"

cd "${NOTE_DIR}" && nvim "${NOTE_PATH}"
